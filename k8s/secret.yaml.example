apiVersion: v1
kind: Secret
metadata:
  name: contacts-db-secret
type: Opaque
stringData:
  DB_CONTACT_SERVICE_HOST: "your-postgres-server.postgres.database.azure.com"
  DB_CONTACT_SERVICE_PORT: "5432"
  DB_CONTACT_SERVICE_NAME: "contacts_db"
  DB_CONTACT_SERVICE_USER: "your_db_user"
  DB_CONTACT_SERVICE_PASSWORD: "your_db_password"